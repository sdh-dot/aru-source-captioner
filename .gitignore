# 의존성은 모든 위치에서, 빌드·검사 출력은 루트에서 제외한다.
node_modules/
/dist/
/coverage/
/test-results/
# 테스트·E2E·벤치마크의 실제 출력 경로다. docs/evidence·screenshots·Fixture는 추적한다.
/docs/results/
*.log
*.tap
*.zip
*.xpi
*.crx
*.pem
*.p12
*.pfx
*.key
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
__pycache__/
.vscode/
.idea/
# 로컬 실행 자료는 루트에 둔다. docs/source/cache 같은 향후 원본 경로는 제외하지 않는다.
/profiles/
/browser-profiles/
/cache/
/tmp/
/temp/

# WXT 출력과 개인 브라우저 실행 설정은 이 Worktree에만 둔다.
/.output/
/.wxt/
/web-ext.config.ts
/.chrome/
